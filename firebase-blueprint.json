{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "A team reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "priority": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "assigneeId": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "date", "time", "priority", "isCompleted", "createdAt"]
    },
    "Visit": {
      "title": "Visit",
      "description": "A scheduled visit/meeting.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "companyId": { "type": "string" },
        "address": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "assigneeId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Em andamento", "Concluído", "Cancelado"] },
        "notes": { "type": "string" },
        "contact": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "date", "time", "status", "notes", "createdAt"]
    },
    "Company": {
      "title": "Company",
      "description": "A registered company/customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Team members"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Registered companies"
    },
    "/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Global team reminders"
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "#/entities/Visit" },
      "description": "Global scheduled visits"
    }
  }
}
